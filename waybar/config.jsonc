// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "bottom",
    "exclusive": true,
    "mode": "dock",
    "modules-left": [
	"custom/pacman",
        "tray",
	"hyprland/workspaces",
        "privacy",
        "hyprland/window"
    ],
    "modules-center": [
        "custom/tasks"
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "cpu",
        "memory",
        "disk",
        "temperature",
        "battery",
        "clock"
    ],

    // Modules configuration
    "clock": {
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
	"calendar": {
            "iso8601": true,
	    "format": {
		"today": "<span color='#6699ff'><b><u>{}</u></b></span>"
	    }
	}
    },
    "tray": {
        "icons": {
            "blueman": "bluetooth",
            "nm-applet": "network-wireless"
        },
        "spacing": 4
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 12,
        "transition-duration": 250,
        "modules": [
            {"type": "screenshare"},
            {"type": "audio-out"},
            {"type": "audio-in"},
            {"type": "location"}
        ],
        "ignore-monitor": true
    },
    "cpu": {
        "interval": 1,
        "format": "{usage}% "
    },
    "memory": {
        "interval": 1,
        "format": "{}% "
    },
    "disk": {
        "format": "{}% 󰨣"
    },
    "temperature": {
        "interval": 1,
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "interval": 1,
        "format": "{ifname} {rxByterate}",
        "format-wifi": "{essid} {icon}",
        "format-ethernet": "Ethernet {linkSpeed}",
        "format-disconnected": "Disconnected",
        "format-disabled": "Disabled",
        "tooltip-format-ethernet": "{ipaddr} over {ifname} {rxByterate} ({bandwidthUpBytes} ↑  {bandwidthDownBytes} ↓)",
        "tooltip-format-wifi": "{ipaddr} over {essid} {frequency}GHz ({bandwidthUpBytes} ↑  {bandwidthDownBytes} ↓)",
        "tooltip-format-ethernet": "{ipaddr} over {ifname} {linkSpeed} ({bandwidthUpBytes} ↑  {bandwidthDownBytes} ↓)",
        "tooltip-format-disconnected": "Disconnected",
        "format-disabled": "Disabled"
    },
    "wireplumber": {
        "format": "{volume}% {icon}  {format_source}",
        "format-bluetooth": "{volume}% {icon}  {format_source}",
        "format-bluetooth-muted": "󰝟   {format_source}",
        "format-muted": "󰝟   {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/pacman": {
        "format": "{} ",
	"tooltip-format": "{} avaialble package updates",
        "min-length": 5,
        "interval": 3600,
        "exec": "checkupdates | wc -l",
        "exec-if": "exit 0",
        "on-click": "sudo pacman -Syu --noconfirm; pkill -SIGRTMIN+8 waybar",
        "signal": 8
    },
    "custom/tasks": {
        "format": "󰣇 ",
        "exec": "ps -e | wc -l",
        "interval": 1,
        "tooltip-format": "{text} current running processes",
        "on-click": "rofi -show drun"
    }
}
